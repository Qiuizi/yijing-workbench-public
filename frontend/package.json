{
  "name": "yijing-workbench",
  "private": true,
  "version": "3.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build:sidecar": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../scripts/build_sidecar.ps1",
    "desktop:dev": "npm run build:sidecar && tauri dev",
    "desktop:build": "npm run build:sidecar && tauri build --bundles nsis"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "element-plus": "^2.9.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.0"
  }
}
