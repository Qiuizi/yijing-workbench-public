  },
  {
    "wenwang_order": 8,
    "name": "比",
    "title": "水地比",
    "binary_code": "010000",
    "upper_trigram": {
      "name": "坎",
      "symbol": "☵",
      "binary_code": "010",
      "image": "水"
    },
    "lower_trigram": {
      "name": "坤",
      "symbol": "☷",
      "binary_code": "000",
      "image": "地"
    },
    "judgment": "比：吉。原筮元永貞，无咎。不寧方來，後夫凶。",
    "line_texts": [
      "初六：有孚，比之，无咎。有孚盈缶，終來有它，吉。",
      "六二：比之自內，貞吉。",
      "六三：比之匪人。",
      "六四：外比之，貞吉。",
      "九五：顯比。王用三驅，失前禽，邑人不誡，吉。",
      "上六：比之无首，凶。"
    ],
    "text_source": "维基文库《周易/比》“易经”原文页；转录字形与标点沿用该页面",
    "source_url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E6%AF%94&oldid=2405022",
    "source_revision_id": 2405022
  },
  {
    "wenwang_order": 9,
    "name": "小畜",
    "title": "风天小畜",
    "binary_code": "110111",
    "upper_trigram": {
      "name": "巽",
      "symbol": "☴",
      "binary_code": "110",
      "image": "风"
    },
    "lower_trigram": {
      "name": "乾",
      "symbol": "☰",
      "binary_code": "111",
      "image": "天"
    },
    "judgment": "小畜：亨。密雲不雨，自我西郊。",
    "line_texts": [
      "初九：復自道，何其咎，吉。",
      "九二：牽復，吉。",
      "九三：輿說輻，夫妻反目。",
      "六四：有孚，血去惕出，无咎。",
      "九五：有孚攣如，富以其鄰。",
      "上九：既雨既處，尚德載，婦貞厲，月幾望，君子征凶。"
    ],
    "text_source": "维基文库《周易/小畜》“易经”原文页；转录字形与标点沿用该页面",
    "source_url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%B0%8F%E7%95%9C&oldid=2405006",
    "source_revision_id": 2405006
  },
  {
    "wenwang_order": 10,
    "name": "履",
    "title": "天泽履",
    "binary_code": "111011",
    "upper_trigram": {
      "name": "乾",
      "symbol": "☰",
      "binary_code": "111",
      "image": "天"
    },
    "lower_trigram": {
      "name": "兑",
      "symbol": "☱",
      "binary_code": "011",
      "image": "泽"
    },
    "judgment": "履虎尾，不咥人，亨。",
    "line_texts": [
      "初九：素履，往无咎。",
      "九二：履道坦坦，幽人貞吉。",
      "六三：眇能視，跛能履，履虎尾，咥人，凶。武人為于大君。",
      "九四：履虎尾，愬愬終吉。",
      "九五：夬履，貞厲。",
      "上九：視履考祥，其旋元吉。"
    ],
    "text_source": "维基文库《周易/履》“易经”原文页；转录字形与标点沿用该页面",
    "source_url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%B1%A5&oldid=2494097",
