  {
    "wenwang_order": 11,
    "name": "泰",
    "title": "地天泰",
    "binary_code": "000111",
    "upper_trigram": {
      "name": "坤",
      "symbol": "☷",
      "binary_code": "000",
      "image": "地"
    },
    "lower_trigram": {
      "name": "乾",
      "symbol": "☰",
      "binary_code": "111",
      "image": "天"
    },
    "judgment": "泰：小往大來，吉亨。",
    "line_texts": [
      "初九：拔茅茹以其彙，征吉。",
      "九二：包荒。用馮河，不遐遺；朋亡。得尚于中行。",
      "九三：无平不陂，无往不復，艱貞无咎。勿恤其孚，于食有福。",
      "六四：翩翩，不富以其鄰；不戒以孚。",
      "六五：帝乙歸妹，以祉，元吉。",
      "上六：城復于隍，勿用師，自邑告命，貞吝。"
    ],
    "text_source": "维基文库《周易/泰》“易经”原文页；转录字形与标点沿用该页面",
    "source_url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E6%B3%B0&oldid=2106138",
    "source_revision_id": 2106138
  },
  {
    "wenwang_order": 12,
    "name": "否",
    "title": "天地否",
    "binary_code": "111000",
    "upper_trigram": {
      "name": "乾",
      "symbol": "☰",
      "binary_code": "111",
      "image": "天"
    },
    "lower_trigram": {
      "name": "坤",
      "symbol": "☷",
      "binary_code": "000",
      "image": "地"
    },
    "judgment": "否之匪人，不利君子貞，大往小來。",
    "line_texts": [
      "初六，拔茅茹以其彙，貞吉。亨。",
      "六二，包承，小人吉，大人否。亨。",
      "六三，包羞。",
      "九四，有命，无咎，疇離祉。",
      "九五，休否，大人吉。其亡其亡，繫于苞桑。",
      "上九，傾否，先否後喜。"
    ],
    "text_source": "维基文库《周易/否》“易经”原文页；转录字形与标点沿用该页面",
    "source_url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%90%A6&oldid=2106139",
    "source_revision_id": 2106139
  },
  {
    "wenwang_order": 13,
    "name": "同人",
    "title": "天火同人",
    "binary_code": "111101",
    "upper_trigram": {
      "name": "乾",
      "symbol": "☰",
      "binary_code": "111",
      "image": "天"
    },
    "lower_trigram": {
      "name": "离",
      "symbol": "☲",
      "binary_code": "101",
      "image": "火"
    },
    "judgment": "同人于野，亨。 利涉大川，利君子貞。",
    "line_texts": [
      "初九：同人于門，無咎。",
      "六二：同人于宗，吝。",
      "九三：伏戎于莽，升其高陵，三歲不興。",
      "九四：乘其墉，弗克，攻吉。",
      "九五：同人，先號啕而后笑。大師克相遇。",
      "上九：同人于郊，無悔。"
    ],
    "text_source": "维基文库《周易/同人》“易经”原文页；转录字形与标点沿用该页面",
    "source_url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%90%8C%E4%BA%BA&oldid=2106140",
    "source_revision_id": 2106140
  },
  {
    "wenwang_order": 14,
    "name": "大有",
    "title": "火天大有",
    "binary_code": "101111",
    "upper_trigram": {
      "name": "离",
      "symbol": "☲",
      "binary_code": "101",
      "image": "火"
    },
    "lower_trigram": {
      "name": "乾",
      "symbol": "☰",
      "binary_code": "111",
      "image": "天"
    },
    "judgment": "大有：元亨。",
    "line_texts": [
      "初九：无交害，匪咎，艱則无咎。",
      "九二：大車以載，有攸往，无咎。",
      "九三：公用亨于天子，小人弗克。",
      "九四：匪其彭，无咎。",
      "六五：厥孚交如，威如；吉。",
      "上九：自天佑之，吉无不利。"
    ],
    "text_source": "维基文库《周易/大有》“易经”原文页；转录字形与标点沿用该页面",
    "source_url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%A4%A7%E6%9C%89&oldid=2494004",
    "source_revision_id": 2494004
  },
  {
    "wenwang_order": 15,
    "name": "谦",
    "title": "地山谦",
    "binary_code": "000100",
    "upper_trigram": {
      "name": "坤",
      "symbol": "☷",
      "binary_code": "000",
      "image": "地"
    },
    "lower_trigram": {
      "name": "艮",
      "symbol": "☶",
      "binary_code": "100",
      "image": "山"
    },
    "judgment": "謙：亨，君子有終。",
    "line_texts": [
      "初六：謙謙君子，用涉大川，吉。",
      "六二：鳴謙，貞吉。",
      "九三：勞謙君子，有終吉。",
      "六四：无不利，撝謙。",
      "六五：不富，以其鄰，利用侵伐，无不利。",
      "上六：鳴謙，利用行師，征邑國。"
    ],
    "text_source": "维基文库《周易/謙》“易经”原文页；转录字形与标点沿用该页面",
    "source_url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%AC%99&oldid=2106142",
    "source_revision_id": 2106142
  },
  {
    "wenwang_order": 16,
    "name": "豫",
    "title": "雷地豫",
    "binary_code": "001000",
    "upper_trigram": {
      "name": "震",
      "symbol": "☳",
      "binary_code": "001",
      "image": "雷"
    },
    "lower_trigram": {
      "name": "坤",
      "symbol": "☷",
      "binary_code": "000",
      "image": "地"
    },
    "judgment": "豫：利建侯行師。",
    "line_texts": [
      "初六：鳴豫，凶。",
      "六二：介于石，不終日，貞吉。",
      "六三：盱豫，悔。遲有悔。",
      "九四：由豫，大有得。勿疑。朋盍簪。",
      "六五：貞疾，恆不死。",
      "上六：冥豫，成有渝，无咎。"
    ],
    "text_source": "维基文库《周易/豫》“易经”原文页；转录字形与标点沿用该页面",
