[
  {
    "wenwang_order": 1,
    "name": "乾",
    "title": "乾为天",
    "binary_code": "111111",
    "upper_trigram": {
      "name": "乾",
      "symbol": "☰",
      "binary_code": "111",
      "image": "天"
    },
    "lower_trigram": {
      "name": "乾",
      "symbol": "☰",
      "binary_code": "111",
      "image": "天"
    },
    "judgment": "乾：元亨。利貞。",
    "line_texts": [
      "初九：潛龍勿用。",
      "九二：見龍在田，利見大人。",
      "九三：君子終日乾乾，夕惕若；厲，无咎。",
      "九四：或躍在淵，无咎。",
      "九五：飛龍在天，利見大人。",
      "上九：亢龍，有悔。"
    ],
    "text_source": "维基文库《周易/乾》“易经”原文页；转录字形与标点沿用该页面",
    "source_url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E4%B9%BE&oldid=2404991",
    "source_revision_id": 2404991,
    "special_line": {
      "name": "用九",
      "text": "用九：見羣龍无首，吉。",
      "source_url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E4%B9%BE&oldid=2404991"
    }
  },
  {
    "wenwang_order": 2,
    "name": "坤",
    "title": "坤为地",
    "binary_code": "000000",
    "upper_trigram": {
      "name": "坤",
      "symbol": "☷",
      "binary_code": "000",
      "image": "地"
    },
    "lower_trigram": {
      "name": "坤",
      "symbol": "☷",
      "binary_code": "000",
      "image": "地"
    },
    "judgment": "坤：元亨。利牝馬之貞。 君子有攸往，先迷後得主。 利西南得朋，東北喪朋。安貞，吉。",
    "line_texts": [
      "初六：履霜，堅冰至。",
      "六二：直方大，不習无不利。",
      "六三：含章，可貞。或從王事，无成有終。",
      "六四：括囊，无咎无譽。",
      "六五：黃裳，元吉。",
      "上六：龍戰于野，其血玄黃。"
    ],
    "text_source": "维基文库《周易/坤》“易经”原文页；转录字形与标点沿用该页面",
    "source_url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%9D%A4&oldid=2404999",
    "source_revision_id": 2404999,
    "special_line": {
      "name": "用六",
      "text": "用六：利永貞。",
      "source_url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%9D%A4&oldid=2404999"
    }
  },
  {
    "wenwang_order": 3,
    "name": "屯",
    "title": "水雷屯",
    "binary_code": "010001",
    "upper_trigram": {
      "name": "坎",
      "symbol": "☵",
      "binary_code": "010",
      "image": "水"
    },
    "lower_trigram": {
      "name": "震",
      "symbol": "☳",
      "binary_code": "001",
      "image": "雷"
    },
    "judgment": "屯：元亨，利貞。勿用有攸往，利建侯。",
    "line_texts": [
      "初九：磐桓，利居貞，利建侯。",
      "六二：屯如邅如，乘馬班如，匪寇婚媾，女子貞不字，十年乃字。",
      "六三：即鹿无虞，惟入于林中，君子幾不如舍，往吝。",
      "六四：乘馬班如，求婚媾，往，吉无不利。",
      "九五：屯其膏；小貞吉，大貞凶。",
      "上六：乘馬班如，泣血漣如。"
    ],
    "text_source": "维基文库《周易/屯》“易经”原文页；转录字形与标点沿用该页面",
    "source_url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%B1%AF&oldid=2527353",
    "source_revision_id": 2527353
  },
  {
    "wenwang_order": 4,
    "name": "蒙",
    "title": "山水蒙",
    "binary_code": "100010",
    "upper_trigram": {
      "name": "艮",
      "symbol": "☶",
      "binary_code": "100",
      "image": "山"
    },
    "lower_trigram": {
      "name": "坎",
      "symbol": "☵",
      "binary_code": "010",
      "image": "水"
    },
    "judgment": "蒙：亨。匪我求童蒙，童蒙求我。初筮告，再三瀆，瀆則不告。利貞。",
    "line_texts": [
      "初六：發蒙，利用刑人，用說桎梏，以往吝。",
      "九二：包蒙吉，納婦吉，子克家。",
      "六三：勿用取女，見金夫，不有躬，无攸利。",
      "六四：困蒙，吝。",
      "六五：童蒙，吉。",
      "上九：擊蒙，不利為寇，利禦寇。"
    ],
    "text_source": "维基文库《周易/蒙》“易经”原文页；转录字形与标点沿用该页面",
    "source_url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%92%99&oldid=2601829",
    "source_revision_id": 2601829
  },
  {
    "wenwang_order": 5,
    "name": "需",
    "title": "水天需",
    "binary_code": "010111",
    "upper_trigram": {
      "name": "坎",
      "symbol": "☵",
      "binary_code": "010",
      "image": "水"
    },
    "lower_trigram": {
      "name": "乾",
      "symbol": "☰",
      "binary_code": "111",
      "image": "天"
    },
    "judgment": "需：有孚，光亨。貞吉，利涉大川。",
    "line_texts": [
      "初九：需于郊，利用恆，无咎。",
      "九二：需于沙，小有言，終吉。",
      "九三：需于泥，致寇至。",
      "六四：需于血，出自穴。",
      "九五：需于酒食，貞吉。",
      "上六：入于穴，有不速之客三人來，敬之終吉。"
    ],
    "text_source": "维基文库《周易/需》“易经”原文页；转录字形与标点沿用该页面",
    "source_url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%9C%80&oldid=2405039",
    "source_revision_id": 2405039
  },
  {
    "wenwang_order": 6,
    "name": "讼",
    "title": "天水讼",
    "binary_code": "111010",
    "upper_trigram": {
      "name": "乾",
      "symbol": "☰",
      "binary_code": "111",
      "image": "天"
    },
    "lower_trigram": {
      "name": "坎",
      "symbol": "☵",
      "binary_code": "010",
      "image": "水"
    },
    "judgment": "訟：有孚，窒，惕，中吉，終凶。利見大人，不利涉大川。",
    "line_texts": [
      "初六：不永所事，小有言，終吉。",
      "九二：不克訟，歸而逋，其邑人三百戶无眚。",
      "六三：食舊德，貞厲，終吉。或從王事，无成。",
      "九四：不克訟，復即命渝，安貞吉。",
      "九五：訟，元吉。",
      "上九：或錫之鞶帶，終朝三褫之。"
    ],
    "text_source": "维基文库《周易/訟》“易经”原文页；转录字形与标点沿用该页面",
    "source_url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%A8%9F&oldid=2405032",
    "source_revision_id": 2405032
  },
  {
    "wenwang_order": 7,
    "name": "师",
    "title": "地水师",
    "binary_code": "000010",
    "upper_trigram": {
      "name": "坤",
      "symbol": "☷",
      "binary_code": "000",
      "image": "地"
    },
    "lower_trigram": {
      "name": "坎",
      "symbol": "☵",
      "binary_code": "010",
      "image": "水"
    },
    "judgment": "師：貞丈人吉，无咎。",
    "line_texts": [
      "初六：師出以律，否臧，凶。",
      "九二：在師中吉，无咎；王三錫命。",
      "六三：師或輿尸，凶。",
      "六四：師左次，无咎。",
      "六五：田有禽，利執言，无咎。長子帥師，弟子輿尸，貞凶。",
      "上六：大君有命，開國承家，小人勿用。"
    ],
    "text_source": "维基文库《周易/師》“易经”原文页；转录字形与标点沿用该页面",
    "source_url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%B8%AB&oldid=2405011",
